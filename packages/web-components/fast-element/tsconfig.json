{
    "extends": "../../../tsconfig.json",
    "compilerOptions": {
        "declarationDir": "dist/dts",
        "outDir": "dist/esm",
        "verbatimModuleSyntax": true,
        "experimentalDecorators": true,
        "strictPropertyInitialization": false,
        "useDefineForClassFields": false,
        "target": "es2022",
        "module": "es2020",
        "types": [
            "mocha",
            "webpack-env",
            "web-ie11"
        ],
        "lib": [
            "DOM",
            "ES2022"
        ]
    },
    "include": ["src"]
}
